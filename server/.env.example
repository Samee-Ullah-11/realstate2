# Copy this file to .env and fill in the values.
PORT=5000
# Local MongoDB, or your MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/shan_property
# Any long random text. Used to sign login tokens.
JWT_SECRET=
# Address of the React app (allowed to call this API)
CLIENT_URL=http://localhost:5173
# Admin account created by "npm run seed"
ADMIN_EMAIL=admin@shanproperty.local
ADMIN_PASSWORD=
# From your Cloudinary dashboard. Needed for photo upload in the admin dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
